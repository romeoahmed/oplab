{
  "name": "oplab",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop assembly workbench for x86_64 and AArch64",
  "license": "MIT OR Apache-2.0",
  "author": {
    "name": "Romeo Ahmed",
    "url": "https://github.com/romeoahmed"
  },
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "paraglide-js compile --outdir ./src/lib/paraglide --strategy localStorage preferredLanguage baseLocale && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "dev": "vite dev",
    "lint": "eslint . --max-warnings 0 && stylelint \"src/**/*.css\" && knip",
    "prepare": "svelte-kit sync",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@lucide/svelte": "^1.45.0",
    "@tauri-apps/api": "^2.11.1",
    "bits-ui": "^2.19.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "2.25.2",
    "@inlang/plugin-message-format": "^4.4.4",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.4",
    "@vitest/browser-playwright": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "fast-check": "^4.10.0",
    "globals": "^17.12.0",
    "knip": "^6.35.1",
    "oxfmt": "0.67.0",
    "playwright": "^1.63.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "vitest-browser-svelte": "^3.1.0"
  },
  "engines": {
    "node": ">=24.21.0"
  }
}
