# GNU C23 adapter policy. The SDK may live outside this repository; keep this
# self-contained and use QEMU's Meson compiler arguments, not C++ bridge defaults.
InheritParentConfig: false
Checks:
  - '-*'
  - clang-analyzer-*
  - bugprone-*
  - concurrency-*
  - performance-*
  - modernize-use-nullptr
  - misc-unused-parameters
  - misc-definitions-in-headers
  - misc-misplaced-const
  - misc-redundant-expression
  - misc-use-internal-linkage
  - readability-braces-around-statements
  - readability-duplicate-include
  - readability-inconsistent-declaration-parameter-name
  - readability-redundant-*
  - readability-simplify-boolean-expr
  # QEMU fixes callback signatures and memory/helper argument order.
  - '-bugprone-easily-swappable-parameters'
  # QEMU's enum/macro masks intentionally mix signed and unsigned C constants.
  - '-bugprone-signed-bitwise'
  # Native JIT entry addresses and GLib's once-init macros intentionally use integer pointers.
  - '-performance-no-int-to-ptr'
WarningsAsErrors: '*'
HeaderFilterRegex: '(^|/)(crates/runtime/native|qemu/oplab)/'
FormatStyle: file
