{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main application window; native commands require explicit grants.",
  "windows": ["main"],
  "permissions": [
    "allow-worker-connect",
    "allow-worker-request",
    "allow-worker-ack",
    "allow-worker-detach",
    "allow-import-file",
    "allow-export-file"
  ]
}
