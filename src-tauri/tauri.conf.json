{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oplab",
  "version": "0.1.0",
  "identifier": "dev.oplab.desktop",
  "build": {
    "beforeDevCommand": "cargo xtask sidecar && pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "cargo xtask sidecar && pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Oplab",
        "width": 1440,
        "height": 900,
        "preventOverflow": true,
        "minWidth": 880,
        "minHeight": 600
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/oplab-worker"]
  }
}
